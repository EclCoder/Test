<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/near_white" />
            <stroke android:width="2.0dp" android:color="@color/sunset_orange" />
            <corners android:radius="5.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/near_white" />
            <stroke android:width="1.5dp" android:color="@color/lesser_grey" />
            <corners android:radius="5.0dp" />
        </shape>
    </item>
</selector>
