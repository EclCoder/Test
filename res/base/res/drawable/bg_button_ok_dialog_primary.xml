<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?colorAccent" />
            <stroke android:width="1.0dp" android:color="?colorAccent" />
            <corners android:radius="30.0dp" />
            <padding android:left="6.0dp" android:top="6.0dp" android:right="6.0dp" android:bottom="6.0dp" />
        </shape>
        <color android:color="@color/pattens_blue" />
    </item>
    <item>
        <shape>
            <solid android:color="@color/white" />
            <stroke android:width="1.0dp" android:color="?colorPrimaryDark" />
            <corners android:radius="30.0dp" />
            <padding android:left="6.0dp" android:top="6.0dp" android:right="6.0dp" android:bottom="6.0dp" />
        </shape>
    </item>
</selector>
