<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red_orange" />
            <corners android:topLeftRadius="0.0dp" android:topRightRadius="5.0dp" android:bottomLeftRadius="5.0dp" android:bottomRightRadius="0.0dp" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sunset_orange" />
            <corners android:topLeftRadius="0.0dp" android:topRightRadius="5.0dp" android:bottomLeftRadius="5.0dp" android:bottomRightRadius="0.0dp" />
        </shape>
    </item>
</selector>
